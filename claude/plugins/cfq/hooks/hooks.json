{
  "description": "cfq host dependency check on SessionStart, plus the PreToolUse guard that denies raw shell mutations of .claude/cfq/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/cfq",
            "args": ["doctor", "hook"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/cfq",
            "args": ["guard", "pretooluse"]
          }
        ]
      }
    ]
  }
}
