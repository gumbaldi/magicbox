#!/usr/bin/env bash
# Single entrypoint for every cfq operation. Routes `cfq <noun> <verb> [args]` to the
# implementation script for <noun>, passing everything after the noun through untouched.
# Deliberately logic-free: the noun-to-script map is the entire contract. Implementations may be
# reimplemented in any language without any caller noticing, which is the point.
#
# Bash 3.2 compatible on purpose (macOS ships 3.2 as /bin/bash) -- avoids every Bash 4+ feature:
# associative arrays, array-key expansion, bulk-read-into-array builtins, case fallthrough,
# case-conversion expansion.
set -eu

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../scripts" && pwd)"

# noun -> script, one script per noun, named for what it operates on rather than for the file.
# A function instead of an associative array (Bash 4+ only) -- see the compat note above.
noun_script() {
  case "$1" in
    batch) echo cfq_batch_id.py ;;
    branch) echo cfq_branch.py ;;
    brief) echo cfq_brief.py ;;
    changelog) echo cfq_changelog.py ;;
    dash) echo cfq_dash.py ;;
    doctor) echo cfq_doctor.py ;;
    finish) echo cfq_finish.py ;;
    guard) echo cfq_guard.py ;;
    lang) echo cfq_lang.py ;;
    layout) echo cfq_layout.py ;;
    lint) echo cfq_lint.py ;;
    lock) echo cfq_lock.py ;;
    maintenance) echo cfq_maintenance.py ;;
    note) echo cfq_note.py ;;
    overlap) echo cfq_queue_overlap.py ;;
    park) echo cfq_park.py ;;
    phase) echo cfq_phase.py ;;
    portal) echo cfq_portal.py ;;
    preflight-plan) echo cfq_pfq_preflight.py ;;
    preflight-impl) echo cfq_ifq_preflight.py ;;
    registry) echo cfq_registry.py ;;
    report) echo cfq_report.py ;;
    resume) echo cfq_resume.py ;;
    runtime) echo cfq_runtime.py ;;
    scan) echo cfq_scan.py ;;
    security) echo cfq_security.py ;;
    settings) echo cfq_settings.py ;;
    telemetry) echo cfq_telemetry.py ;;
    trash) echo cfq_trash.py ;;
    worker) echo cfq_worker.py ;;
    ctx) echo ctx_usage.py ;;
    *) echo "" ;;
  esac
}

NOUNS="batch branch brief changelog dash doctor finish guard lang layout lint lock maintenance note overlap park phase portal preflight-plan preflight-impl registry report resume runtime scan security settings telemetry trash worker ctx"

# Python interpreter discovery: first of python3, python, py (with -3) whose version is >= 3.8.
# Sets PY_CMD (and PY_ARG, only non-empty for the `py -3` case) -- a string pair rather than an
# array, since arrays aren't available in Bash 3.2 either.
PY_CMD=""
PY_ARG=""

find_python() {
  local candidate
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
      PY_CMD="$candidate"
      PY_ARG=""
      return 0
    fi
  done
  if command -v py >/dev/null 2>&1 \
    && py -3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    PY_CMD="py"
    PY_ARG="-3"
    return 0
  fi
  return 1
}

require_python() {
  find_python || {
    echo "cfq: Python 3 is required for '$noun' but was not found on PATH." >&2
    echo "     Install Python 3 (3.8 or newer), or run 'cfq doctor' for the full dependency list." >&2
    exit 127
  }
}

run_python() {
  if [ -n "$PY_ARG" ]; then
    "$PY_CMD" "$PY_ARG" "$@"
  else
    "$PY_CMD" "$@"
  fi
}

# First "# Usage: ..." comment in a script, or its first description comment line if none.
script_one_liner() {
  local f="$script_dir/$1" line
  line="$(grep -m1 -E '^# ?[Uu]sage:' "$f" 2>/dev/null || true)"
  [ -n "$line" ] || line="$(sed -n '2p' "$f" 2>/dev/null || true)"
  printf '%s\n' "${line#\# }"
}

list_nouns() {
  local n
  {
    echo "usage: cfq <noun> <verb> [args...]"
    echo "       cfq <noun> --help"
    echo
    echo "nouns:"
    for n in $(printf '%s\n' $NOUNS | sort); do
      printf '  %-16s %s\n' "$n" "$(script_one_liner "$(noun_script "$n")")"
    done
  } >&2
}

if [ "$#" -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  list_nouns
  [ "$#" -eq 0 ] && exit 1
  exit 0
fi

noun="$1"
shift

script="$(noun_script "$noun")"
if [ -z "$script" ]; then
  echo "cfq: unknown noun '$noun'" >&2
  list_nouns
  exit 1
fi

if [ "${1:-}" = "--help" ]; then
  case "$script" in
    *.py) require_python; out="$(run_python "$script_dir/$script" --help 2>&1)" && help_ok=1 || help_ok=0 ;;
    *)    out="$("$script_dir/$script" --help 2>&1)" && help_ok=1 || help_ok=0 ;;
  esac
  if [ "$help_ok" = "1" ]; then
    printf '%s\n' "$out"
    exit 0
  fi
  echo "$noun ($script):" >&2
  script_one_liner "$script" >&2
  exit 0
fi

case "$script" in
  *.py) require_python; exec "$PY_CMD" ${PY_ARG:+"$PY_ARG"} "$script_dir/$script" "$@" ;;
  *)    exec "$script_dir/$script" "$@" ;;
esac
